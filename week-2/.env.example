# --- Required ---
# Free key from https://console.groq.com/keys
GROQ_API_KEY=

# --- Generation ---
# Current model ids: https://console.groq.com/docs/models (Groq retires them periodically)
GROQ_MODEL=openai/gpt-oss-120b
# Low by default: answering from retrieved text should not be creative.
LLM_TEMPERATURE=0.1

# --- Embeddings ---
# fastembed = local ONNX, no torch, no API key. huggingface = sentence-transformers.
# Changing the model means re-running the ingest: python ingest.py --reset
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Retrieval ---
RETRIEVAL_STRATEGY=hybrid
TOP_K=4
FETCH_K=20
MMR_LAMBDA=0.5
USE_RERANKER=false

# --- Storage ---
CHROMA_DIR=vectorstore
COLLECTION_NAME=documents
PDF_DIR=data/pdfs

# --- Memory ---
HISTORY_WINDOW=6
